# Auto-detect text files
* text=auto

# Source files
*.py text diff=python
*.pyi text diff=python
*.toml text
*.cfg text
*.ini text
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
Makefile text eol=lf

# Documentation
*.md text diff=markdown
*.rst text
*.txt text

# Templates
*.html text diff=html
*.css text
*.js text

# Images
*.png binary
*.jpg binary
*.ico binary

# Docker
Dockerfile text
docker-compose.yml text
.dockerignore text

# CI / Git
.github/** text
.gitignore text
.gitattributes text
.editorconfig text
.pre-commit-config.yaml text

# Archives
*.gz binary
*.zip binary
